# Build settings for the Giolgăii server image (tortoise-server:mine).
# Read by ~/Documents/WoW/build-server.sh. Plain bash assignments (the file is sourced).

# The tortoise-deploy commit whose Dockerfile builds the image. Upstream rewrote its history on
# 2026-10-04 ("Relaunch the project"); moving off this commit is a deliberate migration.
DEPLOY_REPOSITORY=mserajnik/tortoise-deploy
DEPLOY_REVISION=2df74d23e43893113e413fafcde0c32e95985c9d

# Modules cloned into the build: "<dir>=<git url>@<branch or commit>", joined with "|".
# The <dir> name matters: the module's code defines Add<dir>Scripts (non-alphanumerics -> "_").
# mod-thrill-of-the-kill, mod-azeroth-completion and mod-creator-test are not listed: they live
# inside the fork and are built automatically (modules are switched on whenever this is non-empty).
# Pinned to what production's image (built 2026-10-06) runs, so a deploy changes only this fork.
# Moving TortoiseBots forward is a migration: from 2026-10-18 it ships data/sql/character/, which
# DEPLOY_REVISION's Dockerfile rejects ("maps to no database"), and it brings new bot SQL.
MODULES="TortoiseBots=https://github.com/Sagiroth/TortoiseBots.git@f0bf7411ab422b25a9aa56eb573846f8915bf8d3|tw-mod-autoscale=https://github.com/Penqle/tw-mod-autoscale.git@8675af22569674d906479aec0d7883d13d9212bb"

# Every config file the modules install, comma-separated and sorted (C locale).
# Must match exactly or the build stops; the error message prints the expected list.
# Each one also needs a volume line under mangosd in the server's compose.yaml:
#   aiplayerbot.conf                       -> /opt/tortoise/config/aiplayerbot.conf
#   modules/mod-azeroth-completion.conf    -> /opt/tortoise/config/modules/mod-azeroth-completion.conf
#   modules/mod-creator-test.conf          -> /opt/tortoise/config/modules/mod-creator-test.conf (Noggit test helper, stays disabled)
#   modules/mod-thrill-of-the-kill.conf    -> /opt/tortoise/config/modules/mod-thrill-of-the-kill.conf
#   modules/tortoise_bots.conf             -> /opt/tortoise/config/modules/tortoise_bots.conf
#   modules/tw-mod-autoscale.conf          -> /opt/tortoise/config/modules/tw-mod-autoscale.conf
MODULE_CONFIGS="aiplayerbot.conf,modules/mod-azeroth-completion.conf,modules/mod-creator-test.conf,modules/mod-thrill-of-the-kill.conf,modules/tortoise_bots.conf,modules/tw-mod-autoscale.conf"

# Modules from MODULES that ship SQL (comma-separated). The build refuses any other module with SQL.
MODULE_SQL_MODULES="TortoiseBots"

# Extra apt packages the modules need to compile (TortoiseBots uses Boost headers).
MODULE_BUILD_PACKAGES="libboost-dev libboost-filesystem-dev"
